                        cluster = "matching_service"
                        prefix_rewrite = "/api/v1"
                      }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/pricing" }
                      route {
                        cluster = "pricing_service"
                        prefix_rewrite = "/api/v1"
                      }
                    }
                    new Dynamic {
                      match {
                        safe_regex { regex = "^/api/v1/orders/(?i)search" }
                      }
                      route { cluster = "order_service" }
                    }
                    new Dynamic {
                      match {
                        safe_regex { regex = "^/api/v1/orders/(?i)sagas" }
                      }
                      route { cluster = "order_service" }
                    }
                    new Dynamic {
                      match {
                        safe_regex { regex = "^/api/v1/orders/(?i)returns/needs-attention" }
                      }
                      route { cluster = "order_service" }
                    }
                    new Dynamic {
                      match {
                        safe_regex { regex = "^/api/v1/orders/(?i)returns/[^/]+/reject" }
                      }
                      route { cluster = "order_service" }
                    }
                    new Dynamic {
                      match {
                        safe_regex { regex = "^/api/v1/orders/[^/]+/(?i)complete" }
                      }
                      route { cluster = "order_service" }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/cart" }
                      route { cluster = "order_service" }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/orders" }
                      route { cluster = "order_service" }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/reviews" }
                      route { cluster = "review_service" }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/payment" }
                      route { cluster = "payment_service" }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/proofs/registrations" }
                      route { cluster = "notary_service" }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/proofs" }
                      route { cluster = "notary_service" }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/seal/courier-credentials" }
                      route { cluster = "seal_service" }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/seal/holder" }
                      route { cluster = "seal_service" }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/seal/presentations" }
                      route { cluster = "seal_service" }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/seal/verify" }
                      route { cluster = "seal_service" }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/seal/registry" }
                      route { cluster = "seal_service" }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/seal/report-registry" }
                      route { cluster = "seal_service" }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/seal/reporters" }
                      route { cluster = "seal_service" }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/seal/report-rights" }
                      route { cluster = "seal_service" }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/seal/predicates" }
                      route { cluster = "seal_service" }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/notifications/devices" }
                      route { cluster = "notification_service" }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
