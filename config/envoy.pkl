                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = mapTileRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/" }
                          route { cluster = "backoffice_app" }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                      }
                    }
                  }
                }
                http_filters {
                  new Dynamic {
                    name = "envoy.filters.http.rbac"
                    typed_config {
                      ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC"
                      rules {
                        action = "ALLOW"
                        policies {
                          ["allow_all"] {
