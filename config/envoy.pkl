hidden ipv4Octet: String = #"(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"#
hidden ipv4Range: String = #"\#(ipv4Octet)(\.\#(ipv4Octet)){3}(/(3[0-2]|[12][0-9]|[1-9]))?"#
hidden ipv6Range: String = #"[0-9a-f:]*:[0-9a-f:.]*(/(12[0-8]|1[01][0-9]|[1-9][0-9]|[1-9]))?"#
hidden hostPattern: String = #"[a-z0-9.-]+(:[0-9]+)?"#

hidden identityJwtPublicKey: String = read("prop:identityJwtPublicKey")
hidden jwtIssuer: String(!isEmpty) = read("prop:jwtIssuer")
hidden corsOriginsProp: String = read("prop:corsOrigins")
hidden storageHost: String = read?("prop:storageHost") ?? ""
hidden corsOrigins: List<String(this == "*" || matches(Regex(#"https?://[a-z0-9.-]+(:[0-9]+)?"#)))>(!contains("*") || length == 1) =
  corsOriginsProp.split(",").map((origin) -> origin.trim()).filter((origin) -> !origin.isEmpty)

hidden staffRangesProp: String = read("prop:staffRanges")
hidden staffRanges: List<String(matches(Regex("\(ipv4Range)|\(ipv6Range)")))>(!isEmpty) =
  staffRangesProp.split(",").map((range) -> range.trim()).filter((range) -> !range.isEmpty)

hidden publicApiHost: String(matches(Regex(hostPattern))) = read("prop:publicApiHost")

hidden backofficeHostProp: String(
  matches(Regex(hostPattern)),
  !endsWith(":443"),
  !matches(Regex(#"[0-9.]+(:[0-9]+)?"#))
) = read("prop:backofficeHost")
hidden sellerHostProp: String(matches(Regex(hostPattern)), !endsWith(":443")) = read("prop:sellerHost")
hidden backofficeOnionHostProp: String(matches(Regex(#"[a-z2-7]{56}\.onion"#))) = read("prop:backofficeOnionHost")

function pemFile(path: String, marker: String, what: String): String =
  let (text = read("file:\(path)").text)
    if (text.contains(marker)) text
    else throw("the file given as \(what) does not hold one")

hidden backofficeOnionTlsCert: String = pemFile(
  read("prop:backofficeOnionTlsCertFile"),
  "-----BEGIN CERTIFICATE-----",
  "the onion's TLS certificate"
)

hidden backofficeOnionTlsKey: String = pemFile(
  read("prop:backofficeOnionTlsKeyFile"),
  "PRIVATE KEY-----",
  "the onion's TLS private key"
)

hidden backofficeTlsCert: String = pemFile(
  read("prop:backofficeTlsCertFile"),
  "-----BEGIN CERTIFICATE-----",
  "the backoffice host's TLS certificate"
)

hidden backofficeTlsKey: String = pemFile(
  read("prop:backofficeTlsKeyFile"),
  "PRIVATE KEY-----",
  "the backoffice host's TLS private key"
)

hidden internalHost: String = "kinetix-api-gateway"
hidden internalPort: Int = 8000
hidden onionPort: Int = 8081
hidden onionTlsPort: Int = 8444
hidden publicTlsPort: Int = 8443
hidden idleSocketTimeout: Int = 90

hidden hostNames: List<String> = List(
  publicApiHost,
  storageHost,
  backofficeHostProp,
  backofficeOnionHostProp,
  sellerHostProp,
  internalHost
)
  .filter((host) -> !host.isEmpty)
  .map((host) -> host.split(":").first)

function distinctHost(host: String): String =
  if (hostNames.isDistinct) host
  else throw("the public API, storage, backoffice, onion, seller and internal hosts must all differ: \(hostNames
    .map((name) -> if (name.endsWith(".onion")) "<the onion address>" else name)
    .join(", "))")

hidden backofficeHost: String = distinctHost(backofficeHostProp).split(":").first
hidden sellerHost: String = distinctHost(sellerHostProp).split(":").first
hidden backofficeOnionHost: String = distinctHost(backofficeOnionHostProp)

hidden securityTxt: String = List(
  "Contact: https://github.com/WildanFrananda/kinetix-docs/security/advisories/new",
  "Expires: 2027-10-21T00:00:00.000Z",
  "Preferred-Languages: en, id",
  "Canonical: https://\(publicApiHost)/.well-known/security.txt",
  "Policy: https://docs.wildanfrananda.my.id/reference/report-a-vulnerability/",
  ""
).join("\n")

function parseCidr(range: String): Dynamic =
  let (parts = range.split("/"))
    new Dynamic {
      address_prefix = parts.first
      prefix_len = if (parts.length > 1) parts[1].toInt() else (if (parts.first.contains(":")) 128 else 32)
    }

hidden staffPrincipals: List<Dynamic> =
  staffRanges.map((range) -> new Dynamic {
    direct_remote_ip = parseCidr(range)
  })

hidden staffGatePerRoute: Dynamic = new Dynamic {
  ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute"
  rbac {
    rules {
      action = "ALLOW"
      policies {
        ["staff_ranges"] {
          permissions {
            new Dynamic { any = true }
          }
          principals {
            new Dynamic {
              or_ids {
                ids = staffPrincipals
              }
            }
          }
        }
      }
    }
  }
}

hidden jwtPerRoute: Dynamic = new Dynamic {
  ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig"
  requirement_name = "identity_provider"
}

function rateLimitPerRoute(minuteRate: Int): Dynamic = new Dynamic {
  ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit"
  stat_prefix = "http_local_rate_limiter"
  token_bucket {
    max_tokens = minuteRate
    tokens_per_fill = minuteRate
    fill_interval {
      seconds = 60
    }
  }
  filter_enabled {
    runtime_key = "local_rate_limit_enabled"
    default_value {
      numerator = 100
      denominator = "HUNDRED"
    }
  }
  filter_enforced {
    runtime_key = "local_rate_limit_enforced"
    default_value {
      numerator = 100
      denominator = "HUNDRED"
    }
  }
}

hidden defaultRateLimitPerRoute: Dynamic = rateLimitPerRoute(100)
hidden midtransRateLimitPerRoute: Dynamic = rateLimitPerRoute(600)
hidden mapTileRateLimitPerRoute: Dynamic = rateLimitPerRoute(1200)
hidden sealPresentationRateLimitPerRoute: Dynamic = rateLimitPerRoute(20)

hidden corsPolicy: Dynamic = new Dynamic {
  ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.cors.v3.CorsPolicy"
  allow_origin_string_match = corsOrigins.map((origin) ->
    if (origin == "*") new Dynamic { safe_regex { regex = ".*" } }
    else new Dynamic { exact = origin }
  )
  allow_methods = "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  allow_headers = "Accept, Authorization, Content-Type, Idempotency-Key, X-Request-Id, X-Requested-With, X-Kinetix-Client, X-Firebase-AppCheck"
  expose_headers = "X-Request-Id, Allow, Idempotent-Replayed, Location, Retry-After"
  max_age = "3600"
  allow_credentials = false
}

function methodHeader(method: String): Dynamic = new Dynamic {
  name = ":method"
  string_match {
    exact = method
  }
}

function cluster(name: String, host: String, port: Int): Dynamic =
  let (clusterName = name)
    new Dynamic {
      ["name"] = clusterName
      connect_timeout {
        seconds = 5
      }
      type = "STRICT_DNS"
      dns_lookup_family = "V4_ONLY"
      lb_policy = "ROUND_ROBIN"
      load_assignment {
        cluster_name = clusterName
        endpoints {
          new Dynamic {
            lb_endpoints {
              new Dynamic {
                endpoint {
                  address {
                    socket_address {
                      address = host
                      port_value = port
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

function clusterWithTimeout(name: String, host: String, port: Int, idleTimeoutSec: Int): Dynamic = (cluster(name, host, port)) {
  typed_extension_protocol_options {
    ["envoy.extensions.upstreams.http.v3.HttpProtocolOptions"] {
      ["@type"] = "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions"
      common_http_protocol_options {
        idle_timeout {
          seconds = idleTimeoutSec
        }
      }
      use_downstream_protocol_config {}
    }
  }
}

admin {
  address {
    socket_address {
      address = "127.0.0.1"
      port_value = 9901
    }
  }
}

static_resources {
  clusters {
    clusterWithTimeout("edge_service", "kinetix-edge-service", 8080, idleSocketTimeout)
    cluster("backoffice_app", "kinetix-backoffice", 8080)
    cluster("identity_service", "kinetix-identity-service", 5000)
    cluster("catalog_service", "kinetix-catalog-service", 8000)
    cluster("search_service", "kinetix-search-service", 8088)
    cluster("warehouse_service", "kinetix-warehouse-service", 3000)
    cluster("matching_service", "kinetix-matching-service", 4000)
    clusterWithTimeout("matching_merchant_socket", "kinetix-matching-service", 4000, idleSocketTimeout)
    cluster("pricing_service", "kinetix-pricing-service", 6000)
    cluster("order_service", "kinetix-order-service", 8001)
    cluster("review_service", "kinetix-review-service", 8002)
    cluster("payment_service", "kinetix-payment-service", 8003)
    cluster("notary_service", "kinetix-notary-service", 8010)
    cluster("seal_service", "kinetix-seal-service", 8012)
    cluster("notification_service", "kinetix-notification-service", 8004)
    when (!storageHost.isEmpty) {
      cluster("storage_service", "kinetix-object-store", 9000)
    }
  }

  listeners {
    new Dynamic {
      name = "public_tls"
      address {
        socket_address {
          address = "0.0.0.0"
          port_value = publicTlsPort
        }
      }
      filter_chains {
        new Dynamic {
          filter_chain_match {
            server_names = List(publicApiHost, sellerHost, distinctHost(storageHost)).filter((it) -> !it.isEmpty)
          }
          transport_socket {
            name = "envoy.transport_sockets.tls"
            typed_config {
              ["@type"] = "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext"
              common_tls_context {
                tls_certificates {
                  new Dynamic {
                    certificate_chain {
                      filename = "/etc/kinetix/tls/tls.crt"
                    }
                    private_key {
                      filename = "/etc/kinetix/tls/tls.key"
                    }
                  }
                }
              }
            }
          }
          filters {
            new Dynamic {
              name = "envoy.filters.network.http_connection_manager"
              typed_config {
                ["@type"] = "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager"
                stat_prefix = "public_https"
                route_config {
                  name = "public_routes"
                  virtual_hosts {
                    new Dynamic {
                      name = "public_api_vhost"
                      domains = List(publicApiHost, "\(publicApiHost):\(publicTlsPort)", "\(publicApiHost):443")
                      when (!corsOrigins.isEmpty) {
                        typed_per_filter_config {
                          ["envoy.filters.http.cors"] = corsPolicy
                        }
                      }
                      routes {
                        new Dynamic {
                          match { path = "/health" }
                          direct_response {
                            status = 200
                            body { inline_string = "{\"status\":\"ok\"}" }
                          }
                          response_headers_to_add {
                            new Dynamic {
                              header { key = "content-type"; value = "application/json" }
                            }
                          }
                        }
                        new Dynamic {
                          match { path = "/.well-known/security.txt" }
                          direct_response {
                            status = 200
                            body { inline_string = securityTxt }
                          }
                          response_headers_to_add {
                            new Dynamic {
                              header { key = "content-type"; value = "text/plain; charset=utf-8" }
                            }
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/auth/login" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/auth/register" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/auth/refresh" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/auth/2fa/verify" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/couriers/register" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/.well-known/jwks.json" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/sellers/applications" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/couriers/applications" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match {
                            safe_regex { regex = "^/api/v1/sellers/[^/]+/(verify|reject)$" }
                          }
                          route { cluster = "identity_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match {
                            safe_regex { regex = "^/api/v1/couriers/[^/]+/(approve|reject)$" }
                          }
                          route { cluster = "identity_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/auth" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/users" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/sellers" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/couriers" }
                          route { cluster = "identity_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/products/search" }
                          route { cluster = "search_service" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/products/suggest" }
                          route { cluster = "search_service" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/products" }
                          route {
                            cluster = "catalog_service"
                            prefix_rewrite = "/api/products"
                          }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match {
                            prefix = "/api/v1/categories"
                            headers {
                              methodHeader("POST")
                            }
                          }
                          route {
                            cluster = "catalog_service"
                            prefix_rewrite = "/api/categories"
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match {
                            prefix = "/api/v1/categories"
                            headers {
                              methodHeader("PUT")
                            }
                          }
                          route {
                            cluster = "catalog_service"
                            prefix_rewrite = "/api/categories"
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match {
                            prefix = "/api/v1/categories"
                            headers {
                              methodHeader("PATCH")
                            }
                          }
                          route {
                            cluster = "catalog_service"
                            prefix_rewrite = "/api/categories"
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match {
                            prefix = "/api/v1/categories"
                            headers {
                              methodHeader("DELETE")
                            }
                          }
                          route {
                            cluster = "catalog_service"
                            prefix_rewrite = "/api/categories"
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/categories" }
                          route {
                            cluster = "catalog_service"
                            prefix_rewrite = "/api/categories"
                          }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/warehouse/bins" }
                          route {
                            cluster = "warehouse_service"
                            prefix_rewrite = "/api/v1/bins"
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/warehouse/stock_receipts" }
                          route {
                            cluster = "warehouse_service"
                            prefix_rewrite = "/api/v1/stock_receipts"
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
