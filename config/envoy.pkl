                      }
                    }
                    new Dynamic {
                      name = "seller_vhost"
                      domains = List(sellerHost, "\(sellerHost):\(publicTlsPort)", "\(sellerHost):443")
                      routes {
                        new Dynamic {
                          match { prefix = "/bff/" }
                          route {
                            cluster = "edge_service"
                            timeout { seconds = idleSocketTimeout }
                          }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/" }
                          direct_response {
                            status = 404
                            body { inline_string = "{\"message\":\"Not found\"}" }
                          }
                          response_headers_to_add {
                            new Dynamic {
                              header { key = "content-type"; value = "application/json" }
                            }
                          }
                        }
                      }
                    }
                    when (!storageHost.isEmpty) {
                      new Dynamic {
                        name = "storage_vhost"
                        domains = List(distinctHost(storageHost), "\(distinctHost(storageHost)):\(publicTlsPort)", "\(distinctHost(storageHost)):443")
                        routes {
                          new Dynamic {
                            match { prefix = "/" }
                            route { cluster = "storage_service" }
                            per_request_buffer_limit_bytes = 16777216
                          }
                        }
                      }
                    }
                  }
                }
                http_filters {
                  when (!corsOrigins.isEmpty) {
                    new Dynamic {
                      name = "envoy.filters.http.cors"
                      typed_config {
                        ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.cors.v3.Cors"
                      }
                    }
                  }
                  new Dynamic {
                    name = "envoy.filters.http.jwt_authn"
                    typed_config {
                      ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication"
                      providers {
                        ["identity_provider"] {
                          issuer = jwtIssuer
                          remote_jwks {
                            http_uri {
                              uri = "http://kinetix-identity-service:5000/.well-known/jwks.json"
                              cluster = "identity_service"
                              timeout { seconds = 5 }
                            }
                            cache_duration { seconds = 300 }
                          }
                          from_headers {
                            new Dynamic {
                              name = "Authorization"
                              value_prefix = "Bearer "
                            }
                          }
                        }
                      }
                    }
                  }
                  new Dynamic {
                    name = "envoy.filters.http.rbac"
                    typed_config {
                      ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC"
                      rules {
                        action = "ALLOW"
                        policies {
                          ["allow_all"] {
                            permissions { new Dynamic { any = true } }
                            principals { new Dynamic { any = true } }
                          }
                        }
                      }
                    }
                  }
                  new Dynamic {
                    name = "envoy.filters.http.local_ratelimit"
                    typed_config {
                      ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit"
                      stat_prefix = "http_local_rate_limiter"
                    }
                  }
                  new Dynamic {
                    name = "envoy.filters.http.router"
                    typed_config {
                      ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                    }
                  }
                }
              }
            }
          }
        }
        new Dynamic {
          filter_chain_match {
            server_names = List(backofficeHost)
          }
          transport_socket {
            name = "envoy.transport_sockets.tls"
            typed_config {
              ["@type"] = "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext"
              common_tls_context {
                tls_certificates {
                  new Dynamic {
                    certificate_chain { inline_string = backofficeTlsCert }
                    private_key { inline_string = backofficeTlsKey }
                  }
                }
              }
            }
          }
          filters {
            new Dynamic {
              name = "envoy.filters.network.http_connection_manager"
              typed_config {
                ["@type"] = "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager"
                stat_prefix = "backoffice_https"
                route_config {
                  name = "backoffice_routes"
                  virtual_hosts {
                    new Dynamic {
                      name = "backoffice_vhost"
                      domains = List(backofficeHost, "\(backofficeHost):\(publicTlsPort)", "\(backofficeHost):443")
                      routes {
                        new Dynamic {
                          match { prefix = "/bff/" }
                          route {
                            cluster = "edge_service"
                            timeout { seconds = idleSocketTimeout }
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
