                        new Dynamic {
                          match { prefix = "/ws/v1/matching/driver" }
                          route {
                            cluster = "matching_service"
                            prefix_rewrite = "/driver/websocket"
                            upgrade_configs {
                              new Dynamic { upgrade_type = "websocket" }
                            }
                          }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/ws/v1/matching/merchant" }
                          route {
                            cluster = "matching_merchant_socket"
                            prefix_rewrite = "/merchant/websocket"
                            upgrade_configs {
                              new Dynamic { upgrade_type = "websocket" }
                            }
                            timeout { seconds = idleSocketTimeout }
                          }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/matching/drivers" }
                          route {
                            cluster = "matching_service"
                            prefix_rewrite = "/api/v1/drivers"
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/matching/backoffice" }
                          route {
                            cluster = "matching_service"
                            prefix_rewrite = "/api/v1/backoffice"
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/matching" }
                          route {
                            cluster = "matching_service"
                            prefix_rewrite = "/api/v1"
                          }
                          typed_per_filter_config {
                            ["envoy.filters.http.jwt_authn"] = jwtPerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match { prefix = "/api/v1/pricing" }
                          route {
                            cluster = "pricing_service"
                            prefix_rewrite = "/api/v1"
                          }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match {
                            safe_regex { regex = "^/api/v1/orders/(?i)search" }
                          }
                          route { cluster = "order_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match {
                            safe_regex { regex = "^/api/v1/orders/(?i)sagas" }
                          }
                          route { cluster = "order_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match {
                            safe_regex { regex = "^/api/v1/orders/(?i)returns/needs-attention" }
                          }
                          route { cluster = "order_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match {
                            safe_regex { regex = "^/api/v1/orders/(?i)returns/[^/]+/reject" }
                          }
                          route { cluster = "order_service" }
                          typed_per_filter_config {
                            ["envoy.filters.http.rbac"] = staffGatePerRoute
                            ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute
                          }
                        }
                        new Dynamic {
                          match {
                            safe_regex { regex = "^/api/v1/orders/[^/]+/(?i)complete" }
                          }
                          route { cluster = "order_service" }
                          typed_per_filter_config {
