                      route {
                        cluster = "matching_merchant_socket"
                        prefix_rewrite = "/merchant/websocket"
                        upgrade_configs {
                          new Dynamic { upgrade_type = "websocket" }
                        }
                        timeout { seconds = idleSocketTimeout }
                      }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/matching/drivers" }
                      route {
                        cluster = "matching_service"
                        prefix_rewrite = "/api/v1/drivers"
                      }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
                      match { prefix = "/api/v1/matching/backoffice" }
                      route {
                        cluster = "matching_service"
                        prefix_rewrite = "/api/v1/backoffice"
                      }
                      typed_per_filter_config { ["envoy.filters.http.jwt_authn"] = jwtPerRoute }
                    }
                    new Dynamic {
