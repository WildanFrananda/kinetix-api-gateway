        }
      }
      filter_chains {
        new Dynamic {
          filters {
            new Dynamic {
              name = "envoy.filters.network.http_connection_manager"
          typed_config {
            ["@type"] = "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager"
            stat_prefix = "onion_redirect"
            route_config {
              name = "onion_redirect_routes"
              virtual_hosts {
                new Dynamic {
                  name = "onion_redirect_vhost"
                  domains = List(backofficeOnionHost, "\(backofficeOnionHost):\(onionPort)")
                  routes {
                    new Dynamic {
                      match { prefix = "/" }
                      redirect {
                        scheme_redirect = "https"
                        host_redirect = backofficeOnionHost
                        response_code = "PERMANENT_REDIRECT"
                        strip_query = false
                      }
                    }
                  }
                }
              }
            }
            http_filters {
              new Dynamic {
                name = "envoy.filters.http.router"
                typed_config {
                  ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                }
              }
            }
          }
        }
      }
    }
  }
}

new Dynamic {
  name = "onion_tls"
      address {
        socket_address {
          address = "0.0.0.0"
          port_value = onionTlsPort
        }
      }
      filter_chains {
        new Dynamic {
          filter_chain_match {
            server_names = List(backofficeOnionHost)
          }
          transport_socket {
            name = "envoy.transport_sockets.tls"
            typed_config {
              ["@type"] = "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext"
              common_tls_context {
                tls_certificates {
                  new Dynamic {
                    certificate_chain { inline_string = backofficeOnionTlsCert }
                    private_key { inline_string = backofficeOnionTlsKey }
                  }
                }
              }
            }
          }
          filters {
            new Dynamic {
              name = "envoy.filters.network.http_connection_manager"
              typed_config {
                ["@type"] = "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager"
                stat_prefix = "onion_https"
                route_config {
                  name = "onion_routes"
                  virtual_hosts {
                    new Dynamic {
                      name = "onion_vhost"
                      domains = List(backofficeOnionHost, "\(backofficeOnionHost):\(onionTlsPort)")
                      routes {
                        new Dynamic {
                          match { prefix = "/bff/" }
                          route {
                            cluster = "edge_service"
                            timeout { seconds = idleSocketTimeout }
                          }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/tiles/" }
                          route { cluster = "backoffice_app" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = mapTileRateLimitPerRoute }
                        }
                        new Dynamic {
                          match { prefix = "/" }
                          route { cluster = "backoffice_app" }
                          typed_per_filter_config { ["envoy.filters.http.local_ratelimit"] = defaultRateLimitPerRoute }
                        }
                      }
                    }
                  }
                }
                http_filters {
                  new Dynamic {
                    name = "envoy.filters.http.local_ratelimit"
                    typed_config {
                      ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit"
                      stat_prefix = "http_local_rate_limiter"
                    }
                  }
                  new Dynamic {
                    name = "envoy.filters.http.router"
                    typed_config {
                      ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
