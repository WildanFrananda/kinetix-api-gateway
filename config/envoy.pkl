module kinetix.gateway.envoy

import "envoy/Clusters.pkl"
import "envoy/Listeners.pkl"

admin: Dynamic = new Dynamic {
  address {
    socket_address {
      address = "127.0.0.1"
      port_value = 9901
    }
  }
}

layered_runtime: Dynamic = new Dynamic {
  layers {
    new Dynamic {
      name = "static_layer_0"
      static_layer {
        ["envoy.reloadable_features.check_switch_protocol_websocket_handshake"] = false
      }
    }
  }
}

static_resources: Dynamic = new Dynamic {
  clusters = Clusters.all
  listeners = Listeners.all
}
