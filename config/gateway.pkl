_format_version = "3.0"
_transform = true

services {
  new {
    name = "health-service"
    url = "http://127.0.0.1:8080/health"
    routes {
      new {
        name = "health-route"
        paths { "/health" }
        strip_path = false
        plugins {
          new {
            name = "request-termination"
            config {
              status_code = 200
              content_type = "application/json"
              body = "{\"status\":\"ok\",\"gateway\":\"kinetix-api-gateway\",\"engine\":\"Kong/DB-less (Apple Pkl)\",\"mode\":\"production\",\"port\":8080}"
            }
          }
        }
      }
    }
  }

  new {
    name = "identity-service"
    url = "http://kinetix-identity-service:5000/api/auth"
    routes {
      new {
        name = "identity-route"
        paths { "/api/v1/auth" }
        strip_path = true
      }
    }
  }

  new {
    name = "catalog-service"
    url = "http://kinetix-catalog-service:8000/api"
    routes {
      new {
        name = "catalog-route"
        paths {
          "/api/v1/products"
          "/api/v1/cart"
          "/api/v1/checkout"
          "/api/v1/categories"
          "/api/v1/brands"
        }
        strip_path = true
      }
    }
  }

  new {
    name = "warehouse-service"
    url = "http://kinetix-warehouse-service:3000/api/v1"
    routes {
      new {
        name = "warehouse-route"
        paths { "/api/v1/warehouse" }
        strip_path = true
      }
    }
  }

  new {
    name = "matching-service"
    url = "http://kinetix-matching-service:4000/api/v1"
    routes {
      new {
        name = "matching-route"
        paths { "/api/v1/matching" }
        strip_path = true
      }
    }
  }

  new {
    name = "matching-websocket"
    url = "http://kinetix-matching-service:4000/socket/websocket"
    routes {
      new {
        name = "matching-websocket-route"
        paths {
          "/ws/v1/matching/socket"
          "/socket/websocket"
        }
        protocols { "http"; "https" }
        strip_path = true
      }
    }
  }

  new {
    name = "matching-sse"
    url = "http://kinetix-matching-service:4000/api/v1/telemetry/stream"
    routes {
      new {
        name = "matching-sse-route"
        paths { "/api/v1/matching/telemetry/stream" }
        strip_path = true
      }
    }
  }
}

plugins {
  new {
    name = "cors"
    config {
      origins { "*" }
      methods { "GET"; "POST"; "PUT"; "PATCH"; "DELETE"; "OPTIONS" }
      headers { "Accept"; "Authorization"; "Content-Type"; "Idempotency-Key"; "X-Requested-With" }
      credentials = true
      max_age = 3600
    }
  }
  new {
    name = "rate-limiting"
    config {
      minute = 100
      policy = "local"
      fault_tolerant = true
    }
  }
}
