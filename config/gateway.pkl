_format_version = "3.0"
_transform = true

// Core Backend Service Definitions
services {
  // 1. Healthcheck Route (Static JSON 200 OK response via request-termination plugin)
  new {
    name = "health-service"
    url = "http://127.0.0.1:8080/health"
    routes {
      new {
        name = "health-route"
        paths { "/health" }
        strip_path = false
        plugins {
          new {
            name = "request-termination"
            config {
              status_code = 200
              content_type = "application/json"
              body = "{\"status\":\"ok\",\"gateway\":\"kinetix-api-gateway\",\"engine\":\"Kong/DB-less (Apple Pkl)\",\"mode\":\"production\",\"port\":8080}"
            }
          }
        }
      }
    }
  }

  // 2. Identity Service (:5000)
  new {
    name = "identity-service"
    url = "http://kinetix-identity-service:5000/api/auth"
    routes {
      new {
        name = "identity-route"
        paths { "/api/v1/auth" }
        strip_path = true
      }
    }
  }

  // 3. Catalog Service (:8000)
  new {
    name = "catalog-service"
    url = "http://kinetix-catalog-service:8000/api"
    routes {
      new {
        name = "catalog-route"
        paths {
          "/api/v1/products"
          "/api/v1/categories"
          "/api/v1/brands"
        }
        strip_path = true
      }
    }
  }

  // 4. Warehouse OMS Service (:3000)
  new {
    name = "warehouse-service"
    url = "http://kinetix-warehouse-service:3000/api/v1"
    routes {
      new {
        name = "warehouse-route"
        paths { "/api/v1/warehouse" }
        strip_path = true
      }
    }
  }

  // 5. Matching Service REST (:4000)
  new {
    name = "matching-service"
    url = "http://kinetix-matching-service:4000/api/v1"
    routes {
      new {
        name = "matching-route"
        paths { "/api/v1/matching" }
        strip_path = true
      }
    }
  }

  // 6. Matching Service WebSocket Proxy (:4000)
  new {
    name = "matching-websocket"
    url = "http://kinetix-matching-service:4000/socket/websocket"
    routes {
      new {
        name = "matching-websocket-route"
        paths {
          "/ws/v1/matching/socket"
          "/socket/websocket"
        }
        protocols { "http"; "https" }
        strip_path = true
      }
    }
  }

  // 7. Telemetry SSE Stream Proxy (:4000)
  new {
    name = "matching-sse"
    url = "http://kinetix-matching-service:4000/api/v1/telemetry/stream"
    routes {
      new {
        name = "matching-sse-route"
        paths { "/api/v1/matching/telemetry/stream" }
        strip_path = true
      }
    }
  }

  // 8. Pricing Service REST (:6000) [Rocket Rust]
  new {
    name = "pricing-service"
    url = "http://kinetix-pricing-service:6000/api/v1"
    routes {
      new {
        name = "pricing-route"
        paths { "/api/v1/pricing" }
        strip_path = true
      }
    }
  }

  // 9. Order Service REST (:8001) [.NET 10 / C# 13]
  new {
    name = "order-service"
    url = "http://kinetix-order-service:8001/api/v1"
    routes {
      new {
        name = "order-route"
        paths {
          "/api/v1/cart"
          "/api/v1/orders"
        }
        strip_path = true
      }
    }
  }

  // 10. Review Service REST (:8002) [Laravel 13 / PHP 8.5]
  new {
    name = "review-service"
    url = "http://kinetix-review-service:8002/api/v1"
    routes {
      new {
        name = "review-route"
        paths { "/api/v1/reviews" }
        strip_path = true
      }
    }
  }

  // 11. Payment Service REST (:8003) [Spring Boot Java 25]
  new {
    name = "payment-service"
    url = "http://kinetix-payment-service:8003/api/v1"
    routes {
      new {
        name = "payment-route"
        paths { "/api/v1/payment" }
        strip_path = true
      }
    }
  }
}

// Global Plugins
plugins {
  new {
    name = "cors"
    config {
      origins { "*" }
      methods { "GET"; "POST"; "PUT"; "PATCH"; "DELETE"; "OPTIONS" }
      headers { "Accept"; "Authorization"; "Content-Type"; "Idempotency-Key"; "X-Requested-With"; "X-User-Id"; "X-User-Role" }
      credentials = true
      max_age = 3600
    }
  }
  new {
    name = "rate-limiting"
    config {
      minute = 100
      policy = "local"
      fault_tolerant = true
    }
  }
}
