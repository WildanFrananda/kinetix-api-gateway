// Kinetix API gateway — Kong DB-less declarative config. (S2 / P1-GW-01, P1-GW-02)
//
// Two rules govern every entry below.
//
//   1. THE UPSTREAM HOST IS A COMPOSE SERVICE NAME. `kinetix-<svc>-service` is the DNS name
//      on the `kinetix` network. Renaming a service in compose.yaml breaks the route here.
//
//   2. THE PUBLIC PATH AND THE UPSTREAM PATH ARE STATED TOGETHER. Each service records what
//      it actually serves, because `strip_path` is only correct relative to that. Kong strips
//      the matched ROUTE path and appends the remainder to the SERVICE path. Getting this
//      backwards is why four services returned 404 and three worked only by coincidence.
//
// Where the public path already equals the upstream path, the service carries no path and
// `strip_path` is false — nothing is rewritten. Where they differ, the service carries the
// upstream prefix and `strip_path` is true.

_format_version = "3.0"
_transform = true

services {
  // ── health ────────────────────────────────────────────────────────────────────────
  // Answered by Kong itself; never reaches an upstream.
  new {
    name = "health-service"
    url = "http://127.0.0.1:8080/health"
    routes {
      new {
        name = "health-route"
        paths { "/health" }
        strip_path = false
        plugins {
          new {
            name = "request-termination"
            config {
              status_code = 200
              content_type = "application/json"
              body = "{\"status\":\"ok\",\"gateway\":\"kinetix-api-gateway\",\"engine\":\"Kong/DB-less (Apple Pkl)\"}"
            }
          }
        }
      }
    }
  }

  // ── identity :5000 ────────────────────────────────────────────────────────────────
  // NestJS now serves /api/v1/auth, /api/v1/users and /api/v1/sellers — identical to the
  // public paths, so nothing is rewritten and one service covers all three. Previously the
  // upstream had no `v1` segment, which forced a separate Kong service per prefix just to
  // put the version back on.
  new {
    name = "identity-service"
    url = "http://kinetix-identity-service:5000"
    routes {
      new {
        name = "identity-route"
        paths {
          "/api/v1/auth"
          "/api/v1/users"
          "/api/v1/sellers"
        }
        strip_path = false
      }
    }
  }

  // ── catalog :8000 ─────────────────────────────────────────────────────────────────
  // Django serves /api/products/ and /api/categories/. One service pointing at /api with
  // routes for both resources collapsed /api/v1/products/ to /api/ — the resource name was
  // stripped and never restored, so every catalog request 404'd. One service per resource.
  //
  // /api/v1/brands is gone: core/urls.py has no brands route. It was a public path to nothing.
  new {
    name = "catalog-products"
    url = "http://kinetix-catalog-service:8000/api/products"
    routes {
      new {
        name = "catalog-products-route"
        paths { "/api/v1/products" }
        strip_path = true
      }
    }
  }

  new {
    name = "catalog-categories"
    url = "http://kinetix-catalog-service:8000/api/categories"
    routes {
      new {
        name = "catalog-categories-route"
        paths { "/api/v1/categories" }
        strip_path = true
      }
    }
  }

  // ── warehouse :3000 ───────────────────────────────────────────────────────────────
  // Rails serves /api/v1/orders and /api/v1/returns. Public traffic is namespaced under
  // /api/v1/warehouse so it does not collide with order-service, which also owns
  // /api/v1/orders. Strip the namespace, keep the resource.
  new {
    name = "warehouse-service"
    url = "http://kinetix-warehouse-service:3000/api/v1"
    routes {
      new {
        name = "warehouse-route"
        paths { "/api/v1/warehouse" }
        strip_path = true
      }
    }
  }

  // ── matching :4000 ────────────────────────────────────────────────────────────────
  // Phoenix serves /api/v1/drivers, /api/v1/orders/:id, /api/v1/merchant/orders and
  // /api/v1/shipping/options. Same namespacing rationale as warehouse.
  new {
    name = "matching-service"
    url = "http://kinetix-matching-service:4000/api/v1"
    routes {
      new {
        name = "matching-route"
        paths { "/api/v1/matching" }
        strip_path = true
      }
    }
  }

  // The driver socket. One public path, not two: /socket/websocket was also exposed
  // directly, which published Phoenix's internal transport path as a second entry point.
  new {
    name = "matching-websocket"
    url = "http://kinetix-matching-service:4000/socket/websocket"
    routes {
      new {
        name = "matching-websocket-route"
        paths { "/ws/v1/matching/socket" }
        protocols { "http"; "https" }
        strip_path = true
      }
    }
  }

  // Removed: `matching-sse` pointed at /api/v1/telemetry/stream, which does not exist in
  // FleetPulseWeb.Router. It was a public path to a 404, like /api/v1/brands.

  // ── pricing :6000 ─────────────────────────────────────────────────────────────────
  // Rocket serves /api/v1/vouchers, /api/v1/discounts, /api/v1/flash-sales. There is no
  // /api/v1/pricing upstream: the namespace exists only at the gateway and is stripped.
  new {
    name = "pricing-service"
    url = "http://kinetix-pricing-service:6000/api/v1"
    routes {
      new {
        name = "pricing-route"
        paths { "/api/v1/pricing" }
        strip_path = true
      }
    }
  }

  // ── order :8001 ───────────────────────────────────────────────────────────────────
  // ASP.NET serves /api/v1/orders and /api/v1/cart — identical to the public path, so
  // nothing is rewritten. Previously the service carried /api/v1 AND the route stripped
  // /api/v1/orders, so GET /api/v1/orders/1 arrived upstream as /api/v1/1.
  new {
    name = "order-service"
    url = "http://kinetix-order-service:8001"
    routes {
      new {
        name = "order-route"
        paths {
          "/api/v1/cart"
          "/api/v1/orders"
        }
        strip_path = false
      }
    }
  }

  // ── review :8002 ──────────────────────────────────────────────────────────────────
  // Laravel serves /api/v1/reviews/*. Same defect as order-service, same fix.
  new {
    name = "review-service"
    url = "http://kinetix-review-service:8002"
    routes {
      new {
        name = "review-route"
        paths { "/api/v1/reviews" }
        strip_path = false
      }
    }
  }

  // ── payment :8003 ─────────────────────────────────────────────────────────────────
  // Spring serves /api/v1/payment/{checkout,wallet,escrow}. Same defect as order-service:
  // POST /api/v1/payment/checkout/pay arrived upstream as /api/v1/checkout/pay.
  new {
    name = "payment-service"
    url = "http://kinetix-payment-service:8003"
    routes {
      new {
        name = "payment-route"
        paths { "/api/v1/payment" }
        strip_path = false
      }
    }
  }
}

// Global plugins.
//
// Authentication is deliberately absent here and is not an oversight: the JWT boundary,
// the revocation check and the removal of X-User-Id land together in S6. Until then this
// gateway routes but does not authenticate, and every service behind it must assume the
// caller is anonymous.
plugins {
  new {
    name = "cors"
    config {
      origins { "*" }
      methods { "GET"; "POST"; "PUT"; "PATCH"; "DELETE"; "OPTIONS" }
      headers { "Accept"; "Authorization"; "Content-Type"; "Idempotency-Key"; "X-Requested-With" }
      credentials = true
      max_age = 3600
    }
  }
  new {
    name = "rate-limiting"
    config {
      minute = 100
      policy = "local"
      fault_tolerant = true
    }
  }
}
