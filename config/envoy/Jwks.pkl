module kinetix.gateway.envoy.Jwks

function derLen(bytes: List<Int>, idx: Int): Int =
  let (b = bytes[idx])
    if (b < 128) b
    else if (b == 129) bytes[idx + 1]
    else if (b == 130) bytes[idx + 1] * 256 + bytes[idx + 2]
    else throw("unsupported DER length byte \(b)")

function derValOffset(bytes: List<Int>, idx: Int): Int =
  let (b = bytes[idx])
    if (b < 128) idx + 1
    else if (b == 129) idx + 2
    else if (b == 130) idx + 3
    else throw("unsupported DER length byte \(b)")

function fromRsaPem(pem: String): String =
  if (!pem.contains("-----BEGIN PUBLIC KEY-----"))
    throw("identityJwtPublicKey must be a PEM public key")
  else
    let (b64 = pem
      .replaceAll("-----BEGIN PUBLIC KEY-----", "")
      .replaceAll("-----END PUBLIC KEY-----", "")
      .replaceAll(Regex(#"\s+"#), ""))
    let (der = b64.base64DecodedBytes.toList())
    let (seq1 = derValOffset(der, 1))
    let (algVal = derValOffset(der, seq1 + 1))
    let (algLen = derLen(der, seq1 + 1))
    let (bitStr = algVal + algLen)
    let (bitVal = derValOffset(der, bitStr + 1))
    let (rsaSeq = bitVal + 1)
    let (nTag = derValOffset(der, rsaSeq + 1))
    let (nRawOffset = derValOffset(der, nTag + 1))
    let (nRawLen = derLen(der, nTag + 1))
    let (nStart = if (der[nRawOffset] == 0) nRawOffset + 1 else nRawOffset)
    let (nEnd = nRawOffset + nRawLen)
    let (eRawOffset = derValOffset(der, nEnd + 1))
    let (eRawLen = derLen(der, nEnd + 1))
    let (eStart = if (der[eRawOffset] == 0) eRawOffset + 1 else eRawOffset)
    let (eEnd = eRawOffset + eRawLen)
    let (nB64Url = der.sublist(nStart, nEnd).toBytes().base64.replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", ""))
    let (eB64Url = der.sublist(eStart, eEnd).toBytes().base64.replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", ""))
      "{\"keys\":[{\"kty\":\"RSA\",\"alg\":\"RS256\",\"use\":\"sig\",\"n\":\"\(nB64Url)\",\"e\":\"\(eB64Url)\"}]}"
